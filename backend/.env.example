# ----------------------------------------------------
# HOSTELHUB BACKEND ENVIRONMENT CONFIGURATION
# ----------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Client URL (Allowed CORS Origins)
CLIENT_URL=http://localhost:8081

# Database Configuration (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/hostelhub?schema=public
# For Supabase / Neon: postgresql://user:password@ep-host.region.aws.neon.tech/hostelhub?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostelhub?schema=public"

# JWT Authentication Secrets
# Generate strong 64-char strings for production using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="hostelhub_dev_jwt_access_secret_key_change_in_production"
JWT_REFRESH_SECRET="hostelhub_dev_jwt_refresh_secret_key_change_in_production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Campus Geofencing Defaults (Example: University Coordinates)
CAMPUS_LATITUDE=12.9715987
CAMPUS_LONGITUDE=77.5945627
CAMPUS_ALLOWED_RADIUS_METERS=500

# File Upload / Cloud Storage (Optional / Future Phases)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
